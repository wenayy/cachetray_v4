{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/received", "destination": "/received.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/billing-return", "destination": "/billing-return.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/received", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] },
    { "source": "/received.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] },
    { "source": "/received.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] },
    { "source": "/received.css", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] },
    { "source": "/transfer-config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }] },
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
      { "key": "Service-Worker-Allowed", "value": "/" }
    ] },
    { "source": "/manifest.webmanifest", "headers": [
      { "key": "Content-Type", "value": "application/manifest+json" },
      { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
    ] },
    { "source": "/billing-return", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/billing-return.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
